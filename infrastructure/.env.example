# EPOS — local development environment variables
#
# Copy this file to `.env` (same directory) before running `docker compose up`.
# `.env` is gitignored and must NEVER be committed.
#
#   cp infrastructure/.env.example infrastructure/.env
#
# Replace placeholder values with your own local secrets. For production,
# inject these via your secrets manager (Vault / K8s secrets / etc.) —
# never run `docker compose up` with literal credentials in production.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=change_me_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=epos_master

# ─── pgAdmin (web UI on http://127.0.0.1:5050) ────────────────────────────────
PGADMIN_DEFAULT_EMAIL=change_me@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_strong_password

# ─── Spring Boot services ─────────────────────────────────────────────────────
# These must match POSTGRES_USER / POSTGRES_PASSWORD above so that the
# microservices can connect to the database container.
DB_USERNAME=change_me_admin
DB_PASSWORD=change_me_strong_password

# ─── JWT (shared by every service) ────────────────────────────────────────────
# HS256 signing secret — MUST be at least 32 bytes (256 bits). Every service
# refuses to start without it. Generate one with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_bytes

# --- Module IA/BI (#353, #359) ------------------------------------------
# Mots de passe des roles PostgreSQL du module IA (crees par
# init-db/init2-ai.sh). Sans apostrophe. Volume existant : rejouer le script
# a la main (voir son en-tete).
# ai_reader : LECTURE SEULE sur les vues v_ai_* de scoring_db + exam_db.
# ai_writer : ECRIT dans ai_db (cache + journal) et NULLE PART AILLEURS
#             (propriete de robustesse ADR-0029 D2).
AI_READER_PASSWORD=change-me-ai-reader
AI_WRITER_PASSWORD=change-me-ai-writer
